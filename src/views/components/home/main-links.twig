{#
| Variable                     | Type     | Description                                |
|------------------------------|----------|--------------------------------------------|
| component                    | object   | Merchant settings                          |
| component.title              | ?string  | Section title                              |
| component.links              | object[] | list of quick menu links                   |
| component.links[].icon       | string   | sicon-* class                              |
| component.links[].title      | string   |                                            |
| component.links[].url        | string   | resolved variable-list url                 |
| position                     | int      | Sorting number start from zero             |
#}
<section data-testid="store-home-menu-links" class="s-block s-block--quick-menu container">
    {% if component.title %}
        <div class="s-block__title">
            <div class="right-side">
                <h2>{{ component.title }}</h2>
            </div>
        </div>
    {% endif %}
    <div class="grid grid-cols-2 xs:grid-cols-3 md:grid-cols-4 gap-4 sm:gap-6">
        {% for link in component.links %}
            {% if link.title %}
                <a href="{{ link.url }}" class="quick-menu__item">
                    <span class="quick-menu__icon"><i class="{{ link.icon }}"></i></span>
                    <span class="quick-menu__title">{{ link.title }}</span>
                </a>
            {% endif %}
        {% endfor %}
    </div>
</section>
